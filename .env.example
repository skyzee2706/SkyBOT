# Copy this file to ".env" for local development.
# On Vercel, add the same variables under Project Settings > Environment Variables.

# ===== Discord: https://discord.com/developers/applications > your application =====
# General Information > Application ID
DISCORD_CLIENT_ID=
# General Information > Public Key
DISCORD_PUBLIC_KEY=
# OAuth2 > Client Secret (click "Reset Secret")
DISCORD_CLIENT_SECRET=
# Bot > Reset Token
DISCORD_BOT_TOKEN=

# ===== Database: https://neon.tech > your project > Connect =====
# Turn off "Connection pooling" and copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# ===== Public URL of the web app =====
# Local: http://localhost:5173   |   Vercel: https://<project>.vercel.app
PUBLIC_URL=http://localhost:5173

# ===== Upstash QStash: https://console.upstash.com/qstash (Vercel only, optional locally) =====
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ===== X / Twitter: https://developer.x.com > your app > Keys and tokens =====
# "Consumer Keys" (API Key and Secret). Used only for X login; no paid plan required.
# Leave empty to disable X tasks.
X_API_KEY=
X_API_SECRET=

# ===== Vercel only =====
# Any long random string; protects the daily cron endpoint
CRON_SECRET=
# Required on Vercel so Discord request signatures can be verified
NODEJS_HELPERS=0

# Discord user IDs allowed to open the hidden /admin statistics page, separated by commas,
# e.g. ADMIN_DISCORD_IDS=123456789012345678,234567890123456789 (IDs are 17-20 digits).
# Log in with Discord on the web to use it. Leave empty to disable the page.
ADMIN_DISCORD_IDS=

# Optional Discord webhook URL for alerts (e.g. a draw that was interrupted and is retrying)
ALERT_WEBHOOK_URL=

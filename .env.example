# Salin file ini jadi ".env" (untuk lokal). Untuk Vercel, isi yang sama di
# Project Settings > Environment Variables.

# ===== Discord — https://discord.com/developers/applications > aplikasi kamu =====
# General Information > Application ID
DISCORD_CLIENT_ID=
# General Information > Public Key
DISCORD_PUBLIC_KEY=
# OAuth2 > Client Secret (klik Reset Secret)
DISCORD_CLIENT_SECRET=
# Bot > Reset Token
DISCORD_BOT_TOKEN=

# ===== Database — https://neon.tech > project > Connect =====
# Matikan toggle "Connection pooling", salin connection string-nya
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# ===== URL web =====
# Lokal: http://localhost:5173   |   Vercel: https://nama-project.vercel.app
PUBLIC_URL=http://localhost:5173

# ===== Upstash QStash — https://console.upstash.com/qstash (khusus Vercel, lokal boleh kosong) =====
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ===== X / Twitter — https://developer.x.com > Developer Console > App kamu > Keys and tokens =====
# Bagian "Consumer Keys" (API Key and Secret). Hanya untuk login X, tidak perlu isi kredit.
# Kosongkan kalau belum mau pakai task X.
X_API_KEY=
X_API_SECRET=

# ===== Khusus Vercel =====
# Password bebas (acak & panjang) untuk melindungi cron harian
CRON_SECRET=
# WAJIB di Vercel: supaya verifikasi tanda tangan Discord bisa jalan
NODEJS_HELPERS=0

# PIN halaman tersembunyi /admin (statistik), 6-12 angka. Kosong = halaman admin nonaktif.
# Jangan tulis PIN asli di file ini / di kode — isi di Vercel > Environment Variables.
ADMIN_PIN=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id // Discord user ID
  username  String
  avatar    String?
  createdAt DateTime  @default(now()) // pertama kali login
  lastLoginAt DateTime?
  sessions  Session[]
}

// Percobaan login halaman /admin (untuk membatasi tebak-tebakan PIN)
model AdminAttempt {
  id        String   @id @default(cuid())
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Session {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String
  expiresAt   DateTime

  @@index([userId])
}

enum RaffleStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum Allocation {
  GTD
  FCFS
}

enum WalletType {
  NONE
  EVM
  SOL
}

model Raffle {
  id          String       @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  title       String
  description String       @default("")
  imageUrl    String?
  winnerCount Int // total pemenang (= gtdCount + fcfsCount untuk raffle baru)
  // Allocations. Keduanya 0 = raffle lama (sebelum ada allocation), ditampilkan sebagai "Winners".
  gtdCount    Int          @default(0)
  fcfsCount   Int          @default(0)
  chain       String? // lihat CHAINS di src/server/raffle/chains.ts
  // "Hosted by" di embed: nama & foto profil Discord pembuat raffle (disimpan saat dibuat)
  hostName    String?
  hostAvatar  String?
  endsAt      DateTime
  status      RaffleStatus @default(ACTIVE)

  // Requirements
  requiredRoleIds    String[]
  blockedRoleIds     String[]   // fitur lama (sudah dihapus dari dashboard), tetap dicek untuk raffle lama
  // true = cukup punya SALAH SATU required role (raffle baru); false = harus punya semua (raffle lama)
  requireAnyRole     Boolean    @default(false)
  minAccountAgeDays  Int        @default(0)
  walletType         WalletType @default(NONE)

  // Task X (tidak diverifikasi — peserta cukup klik tombol task lalu konfirmasi)
  xFollowUsernames String[]
  // Daftar post: [{ tweetId, like, retweet, quote }]. Quote = peserta wajib kirim link quote-nya.
  xPosts           Json     @default("[]")
  // Kolom lama (1 post per raffle) — hanya dibaca untuk raffle lama, lihat getXPosts()
  xTweetId         String?
  xLike            Boolean  @default(false)
  xRetweet         Boolean  @default(false)
  xQuote           Boolean  @default(false)

  winnerRoleId String?
  // Di-mention saat raffle diposting. ID = guildId berarti @everyone.
  mentionRoleIds String[]
  createdById  String
  createdAt    DateTime @default(now())
  endedAt      DateTime?
  // Kapan jumlah peserta di embed Discord terakhir di-update (dibatasi supaya tidak kena rate limit)
  messageSyncedAt DateTime?

  entries      Entry[]
  taskProgress TaskProgress[]

  @@index([guildId])
  @@index([status])
}

enum EntryStatus {
  ENTERED
  WON
  DISQUALIFIED
}

model Entry {
  id        String      @id @default(cuid())
  raffleId  String
  raffle    Raffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  userId    String
  username  String
  wallet    String?
  xUsername String?
  // Link quote, urutannya sama dengan post ber-task quote di Raffle.xPosts
  xQuoteUrls String[]
  xQuoteUrl  String? // kolom lama (1 quote)
  status    EntryStatus @default(ENTERED)
  allocation Allocation? // diisi saat menang (GTD / FCFS); null untuk raffle lama
  note      String?
  createdAt DateTime    @default(now())

  @@unique([raffleId, userId])
  @@unique([raffleId, wallet])
  @@index([raffleId, status])
}

// Akun X yang terhubung ke akun Discord (1 akun X hanya untuk 1 akun Discord)
// Task X yang sudah dibuka peserta (lewat /api/x/task), plus token interaksi Discord
// untuk memperbarui pesan daftar task-nya (token berlaku 15 menit).
model TaskProgress {
  raffleId         String
  raffle           Raffle    @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  userId           String
  done             String[]
  appId            String?
  interactionToken String?
  tokenAt          DateTime?

  @@id([raffleId, userId])
}

model XLink {
  discordId  String   @id
  xUserId    String   @unique
  xUsername  String
  linkedAt   DateTime @default(now())
}

// Penyimpanan sementara selama proses login X (OAuth 1.0a)
model XAuthState {
  oauthToken  String   @id
  tokenSecret String
  discordId   String
  createdAt   DateTime @default(now())
}

// Gambar raffle yang di-upload dari web (sudah dikompres di browser), disajikan lewat /api/images/:id
model Image {
  id         String   @id @default(cuid())
  guildId    String
  uploaderId String
  mime       String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([uploaderId, createdAt])
}

model GuildSettings {
  guildId        String   @id
  // Role yang boleh mengelola raffle di web (mis. @CM), selain Admin / Manage Server
  managerRoleIds String[]
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id // Discord user ID
  username    String
  avatar      String?
  createdAt   DateTime  @default(now()) // pertama kali login
  lastLoginAt DateTime?
  sessions    Session[]
}

// Tabel lama (login admin pakai PIN, sudah diganti login Discord). Dihapus di deploy berikutnya.
model AdminAttempt {
  id        String   @id @default(cuid())
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@ignore
}

model Session {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String
  expiresAt   DateTime

  @@index([userId])
}

enum RaffleStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum Allocation {
  GTD
  FCFS
}

enum WalletType {
  NONE
  EVM
  SOL
  CUSTOM // chain yang diketik manual (Zcash, Sui, ...): wallet diisi manual tiap raffle, tidak disimpan
}

model Raffle {
  id          String       @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  title       String
  description String       @default("")
  imageUrl    String?
  winnerCount Int // total pemenang (= gtdCount + fcfsCount untuk raffle baru)
  // Allocations. Keduanya 0 = raffle lama (sebelum ada allocation), ditampilkan sebagai "Winners".
  gtdCount    Int          @default(0)
  fcfsCount   Int          @default(0)
  chain       String? // lihat CHAINS di src/server/raffle/chains.ts
  // "Hosted by" di embed: nama & foto profil Discord pembuat raffle (disimpan saat dibuat)
  hostName    String?
  hostAvatar  String?
  // Nama & ikon server saat raffle dibuat (untuk daftar raffle publik; diisi ulang otomatis kalau kosong)
  guildName   String?
  guildIcon   String?
  endsAt      DateTime
  status      RaffleStatus @default(ACTIVE)

  // Requirements
  requiredRoleIds   String[] // peserta cukup punya SALAH SATU role ini
  // Kolom lama (tidak dipakai kode, @ignore). Dihapus dari database di deploy berikutnya, setelah versi ini live.
  blockedRoleIds    String[]   @ignore
  requireAnyRole    Boolean    @default(false) @ignore
  // true = peserta wajib member server (default, juga untuk semua raffle lama);
  // false = non-member boleh ikut lewat web (required role tidak bisa dipakai)
  requireMember     Boolean    @default(true)
  inviteUrl         String? // link invite server (opsional), jadi tombol "Join server" di web
  minAccountAgeDays Int        @default(0)
  walletType        WalletType @default(NONE)

  // Task X (tidak diverifikasi — peserta cukup klik tombol task lalu konfirmasi)
  xFollowUsernames String[]
  // Daftar post: [{ tweetId, like, retweet, quote }]. Quote = peserta wajib kirim link quote-nya.
  xPosts           Json     @default("[]")
  // Kolom lama (tidak dipakai kode, @ignore). Dihapus dari database di deploy berikutnya, setelah versi ini live.
  xTweetId         String?  @ignore
  xLike            Boolean  @default(false) @ignore
  xRetweet         Boolean  @default(false) @ignore
  xQuote           Boolean  @default(false) @ignore

  winnerRoleId    String?
  // Di-mention saat raffle diposting. ID = guildId berarti @everyone.
  mentionRoleIds  String[]
  createdById     String
  createdAt       DateTime  @default(now())
  endedAt         DateTime?
  // Kapan jumlah peserta di embed Discord terakhir di-update (dibatasi supaya tidak kena rate limit)
  messageSyncedAt DateTime?

  // Undian berjalan bertahap & bisa dilanjutkan kalau terputus (error Discord, batas waktu server):
  // drawPending = pemenang belum lengkap diundi; announcePending = pengumuman belum terkirim.
  // drawLockUntil mencegah dua proses mengundi raffle yang sama bersamaan.
  drawPending     Boolean   @default(false)
  announcePending Boolean   @default(false)
  drawLockUntil   DateTime?
  drawError       String? // error terakhir saat mengundi / mengumumkan (untuk halaman admin)

  entries      Entry[]
  taskProgress TaskProgress[]
  auditLogs    AuditLog[]

  @@index([guildId])
  @@index([status, endsAt])
  @@index([drawPending])
  @@index([announcePending])
}

enum EntryStatus {
  ENTERED
  WON
  DISQUALIFIED
}

model Entry {
  id         String      @id @default(cuid())
  raffleId   String
  raffle     Raffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  userId     String
  username   String
  avatar     String? // hash avatar Discord saat ikut (untuk daftar peserta publik)
  wallet     String?
  xUsername  String?
  // Link quote, urutannya sama dengan post ber-task quote di Raffle.xPosts
  xQuoteUrls String[]
  // Kolom lama (tidak dipakai kode, @ignore). Dihapus dari database di deploy berikutnya, setelah versi ini live.
  xQuoteUrl  String?     @ignore
  status     EntryStatus @default(ENTERED)
  allocation Allocation? // diisi saat menang (GTD / FCFS); null untuk raffle lama
  note       String?
  createdAt  DateTime    @default(now())

  @@unique([raffleId, userId])
  @@unique([raffleId, wallet])
  @@index([raffleId, status])
  @@index([userId, createdAt]) // halaman "My entries"
}

// Task X yang sudah dibuka peserta di web (lewat /api/x/task)
model TaskProgress {
  raffleId         String
  raffle           Raffle    @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  userId           String
  done             String[]
  // Kolom lama (tidak dipakai kode, @ignore). Dihapus dari database di deploy berikutnya, setelah versi ini live.
  appId            String?   @ignore
  interactionToken String?   @ignore
  tokenAt          DateTime? @ignore

  @@id([raffleId, userId])
}

// Akun X yang terhubung ke akun Discord (1 akun X hanya untuk 1 akun Discord)
model XLink {
  discordId String   @id
  xUserId   String   @unique
  xUsername String
  linkedAt  DateTime @default(now())
}

// Penyimpanan sementara selama proses login X (OAuth 1.0a)
model XAuthState {
  oauthToken  String   @id
  tokenSecret String
  discordId   String
  returnTo    String? // halaman web tujuan setelah berhasil (mis. /raffle/xxx); null = dari Discord
  createdAt   DateTime @default(now())
}

// Gambar raffle yang di-upload dari web (sudah dikompres di browser), disajikan lewat /api/images/:id
model Image {
  id         String   @id @default(cuid())
  guildId    String
  uploaderId String
  mime       String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([uploaderId, createdAt])
}

model GuildSettings {
  guildId        String   @id
  // Role yang boleh mengelola raffle di web (mis. @CM), selain Admin / Manage Server
  managerRoleIds String[]
}

// Wallet peserta (disimpan sekali, dipakai untuk semua raffle). Kunci = ID Discord, jadi peserta dari bot
// yang belum pernah login web juga punya. 1 wallet hanya bisa terhubung ke 1 akun Discord.
model UserWallet {
  discordId String   @id
  evm       String?  @unique
  sol       String?  @unique
  updatedAt DateTime @updatedAt
}

// Riwayat aksi host / manager per raffle (dibuat, diedit, diakhiri, dibatalkan, diskualifikasi)
model AuditLog {
  id        String   @id @default(cuid())
  raffleId  String
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  actorId   String // ID Discord; "system" untuk aksi otomatis
  actorName String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([raffleId, createdAt])
}

// Pembatas request per user / per aksi (jendela waktu tetap)
model RateLimit {
  key       String   @id // "<aksi>:<userId>:<awal jendela>"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// Migrasi data yang sudah dijalankan (lihat scripts/db-migrate.ts)
model DataMigration {
  id    String   @id
  ranAt DateTime @default(now())
}
